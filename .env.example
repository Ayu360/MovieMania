# This file is a template. Actual values live in .env (gitignored).
# For env switching, keep populated .env.dev and .env.prod alongside .env,
# then run `yarn env:dev` or `yarn env:prod` to swap.

EXPO_PUBLIC_OMDB_API_KEY=your_omdb_api_key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id_from_firebase.apps.googleusercontent.com

# dev: your Mac's LAN IP + backend port, e.g. http://192.168.1.7:4000
# prod: your Render URL, e.g. https://moviemania-backend-xxxx.onrender.com
EXPO_PUBLIC_BACKEND_URL=http://your_lan_ip:4000
